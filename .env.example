# Copy this file to .env and fill in your credentials. .env is gitignored.
#
# Used by the integration tests (go test -tags integration ./...). In your own
# code the client reads NUSII_API_KEY, NUSII_ACCESS_TOKEN and NUSII_BASE_URL
# from the environment when no credentials are passed.

# Personal API token from https://app.nusii.com/settings/api
NUSII_API_KEY=

# Or an OAuth 2.0 access token (used when NUSII_API_KEY is empty)
NUSII_ACCESS_TOKEN=

# Optional: point at another server, e.g. http://localhost:3000
NUSII_BASE_URL=

# Optional: let the integration tests create (and delete) records
NUSII_INTEGRATION_WRITE=

# Optional: also send the test proposal to this address (sends a real email)
NUSII_INTEGRATION_SEND_TO=
